 from torch.nn import functional as F
 
 
+# ---------------------------------------------------------------------------
+# gym-microrts 0.6.0 compatibility
+# ---------------------------------------------------------------------------
+# This package was written against the pre-0.4 gym-microrts API, where
+#   - envs.action_space.nvec was the PER-CELL layout [h*w, 6,4,4,4,4,7,49],
+#     so nvec[1:] meant "the seven action planes", and
+#   - envs.vec_client.getMasks(0) returned masks with the source-unit flag
+#     as a leading column.
+# In gym-microrts 0.6.0 the action space is FLATTENED (nvec is the seven
+# planes repeated h*w times) and the planes live in envs.action_plane_space.
+# Masks come from envs.get_action_mask(), which strips the source-unit
+# column but stashes it in envs.source_unit_mask — and setting that mask is
+# a REQUIRED side effect: envs.step() uses it to build the Java action
+# arrays, so the raw vec_client call must not be used to bypass it.
+# The helpers below detect which API is installed so the rest of the file
+# stays unchanged and works under both.
+
+def action_plane_nvec(envs):
+    """The seven per-cell action-plane sizes, on either gym-microrts API."""
+    if hasattr(envs, "action_plane_space"):          # gym-microrts >= 0.4
+        return envs.action_plane_space.nvec
+    return envs.action_space.nvec[1:]                # old per-cell layout
+
+
+def get_invalid_action_masks(envs, device):
+    """
+    Per-cell invalid-action masks in the OLD layout this package expects:
+    [num_envs, h*w, 1 + sum(planes)], leading column = source-unit flag.
+    On 0.6.0 this goes through get_action_mask() so envs.source_unit_mask
+    is refreshed before the caller steps the env.
+    """
+    if hasattr(envs, "get_action_mask"):             # gym-microrts >= 0.4
+        planes = np.asarray(envs.get_action_mask())
+        source = np.asarray(envs.source_unit_mask)
+        source = source.reshape(planes.shape[0], planes.shape[1], 1)
+        merged = np.concatenate([source.astype(planes.dtype), planes], axis=2)
+        return torch.tensor(merged, dtype=torch.bool).to(device)
+    return torch.tensor(np.array(envs.vec_client.getMasks(0)),
+                        dtype=torch.bool).to(device)
+
+
